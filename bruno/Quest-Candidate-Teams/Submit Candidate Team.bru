meta {
  name: Submit Candidate Team
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v2/quests/{{questId}}/teams/{{teamId}}/submit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{idempotencyKey}}
  Cookie: {{userSessionCookie}}
}

body:json {
  {
    "text": "ทีมเรามีความพร้อมทั้งอุปกรณ์และประสบการณ์ พร้อมเริ่มงานได้ทันทีครับ",
    "fileIds": [
      "00000000-0000-0000-0000-000000000000"
    ]
  }
}

script:pre-request {
  bru.setVar("idempotencyKey", crypto.randomUUID());
}

docs {
  Team Leader locks and submits the full Candidate Team application with text and at least one file attachment for Hirer review.
}
