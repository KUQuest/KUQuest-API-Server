meta {
  name: Simulate Top-up Payment
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/top-ups/{{topUpId}}/simulate
  body: none
  auth: none
}

headers {
  Cookie: {{userSessionCookie}}
}

docs {
  Test-mode simulation action (available in Development and Staging only).
  Simulates a successful mobile banking PromptPay payment via Xendit Sandbox and reconciles funds into the user's spendingBalanceSatang.
}
