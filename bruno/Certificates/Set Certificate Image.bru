meta {
  name: Set Certificate Image
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/profile/certificates/{{certificateId}}/image
  body: multipartForm
  auth: none
}

headers {
  Cookie: {{userSessionCookie}}
}

body:multipart-form {
  image: @file(/home/simon/Pictures/profiles/ray.jpg)
}

docs {
  Replace the @file(...) path with a real JPEG/PNG/WebP under 5 MB before
  sending.
}
