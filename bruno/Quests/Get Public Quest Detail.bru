meta {
  name: Get Public Quest Detail
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v2/quests/{{questId}}/public
  body: none
  auth: none
}

headers {
  Cookie: {{userSessionCookie}}
}

docs {
  Returns the public projection of an open, non-hidden Quest for other Members/Workers.
  Omits financial internals, hirer private data, and internal status.
}
