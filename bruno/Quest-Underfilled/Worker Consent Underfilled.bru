meta {
  name: Worker Consent Underfilled
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v2/quests/{{questId}}/underfilled/consent
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{idempotencyKey}}
  Cookie: {{userSessionCookie}}
}

body:json {
  {
    "decision": "ACCEPT"
  }
}

script:pre-request {
  bru.setVar("idempotencyKey", crypto.randomUUID());
}

docs {
  Active Worker responds to the Hirer's decision to proceed with an underfilled group (ACCEPT or DECLINE).
  If all active workers ACCEPT, the Quest advances to QUEST_ASSIGNED with adjusted individual rewards.
}
